# Anthropic API-Key für die LLM-Erzählschicht (Analysen, später Personas).
# Ohne Key läuft die Simulation vollständig regelbasiert weiter.
ANTHROPIC_API_KEY=

# Optional: Modell für die Erzählschicht (Default: claude-sonnet-4-6)
# BOARDROOM_MODEL=claude-sonnet-4-6

# Optional: Server-Port (Default: 3001)
# PORT=3001
