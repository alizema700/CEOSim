# ── LLM-Erzählschicht (Personas, Analysen, Ideen-Klassifikation) ──────
# EINEN der beiden Keys setzen — die Datei gehört als `server/.env` ins
# server/-Verzeichnis (dort startet der Dev-Prozess). Ohne Key läuft die
# Simulation vollständig regelbasiert weiter.

# Option A: OpenAI (Key von platform.openai.com, beginnt mit sk-...)
OPENAI_API_KEY=

# Option B: Anthropic (Key von console.anthropic.com, beginnt mit sk-ant-...)
ANTHROPIC_API_KEY=

# Optional: Modell überschreiben.
# OpenAI-Default: gpt-4o-mini · Anthropic-Default: claude-sonnet-4-6
# BOARDROOM_MODEL=gpt-4o-mini

# Optional: Provider erzwingen, falls beide Keys gesetzt sind (openai|anthropic)
# BOARDROOM_PROVIDER=openai

# Optional: Server-Port (Default: 3001)
# PORT=3001
